# Keep local runtime state, credentials and environment files out of cloud builds.
**/node_modules/**
**/.git/**
**/.expo/**
**/dist/**
**/.next/**
**/.vinext/**
**/.wrangler/**
**/.sites-runtime/**
**/outputs/**
**/coverage/**
**/.local/**
**/.env*
**/.dev.vars*
**/.aws/**
**/.codex/**
**/.agents/**
**/*.log
**/*.tsbuildinfo
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.mobileprovision
**/credentials.json
**/service-account*.json
**/.DS_Store
# Native folders are generated by Expo Prebuild in the cloud.
/mobile/android/
/mobile/ios/
/android/
/ios/
# Website-only source/assets are not needed by the mobile build.
/app/
/components/
/db/
/drizzle/
/examples/
/hooks/
/public/
/scripts/
/vendor/
/worker/
/.openai/
