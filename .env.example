# Variable names/placeholders only. Never commit real environment or key files.
# Full-stack launcher sets this automatically for local website development.
PARKLY_BACKEND_URL=http://127.0.0.1:5191
# Remote API URLs must use HTTPS and the matching server-only secret binding:
# PARKLY_BACKEND_KEY=<runtime-secret-at-least-32-characters>
# Do not expose this key or DATABASE_URL through VITE/NEXT_PUBLIC variables.
# PostgreSQL credentials belong to the Node service; see backend/.env.example.

# Only when deliberately using the preserved LEGACY D1 adapter without a backend URL:
# PARKLY_AUTH_MODE=demo
# Demo roles are loopback-only. Remote legacy default is read-only/disabled.
# Worker bindings are provided with ignored .dev.vars or approved hosting secrets;
# copying this file to .env does not itself configure a hosted Worker binding.

# Read-only PWA smoke-test target; loopback only.
PARKLY_TEST_URL=http://127.0.0.1:5173
# Web Push server configuration is described in backend/.env.example.
# No real payment, barrier or physical occupancy provider is configured.
