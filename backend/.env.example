# Placeholders only. Inject actual secrets outside the repository.
DATABASE_URL=postgresql://parkly_api:CHANGE_ME@127.0.0.1:55432/parkly
MIGRATION_DATABASE_URL=postgresql://parkly_migrator:CHANGE_ME@127.0.0.1:55432/parkly
PARKLY_PUBLIC_ORIGIN=http://127.0.0.1:5173
PARKLY_API_PORT=5191
# Remote listener / remote bridge only:
# PARKLY_API_HOST=0.0.0.0
# PARKLY_BACKEND_KEY=<matching-server-only-secret>

# API + worker share these; never expose the encryption key to a browser.
# PARKLY_VAPID_PUBLIC_KEY=<public-key>
# PARKLY_PUSH_ENCRYPTION_KEY=<base64url-32-byte-secret>

# Worker only; provision a non-owner role with parkly_notifications membership.
# PARKLY_NOTIFICATION_DATABASE_URL=postgresql://parkly_notify:CHANGE_ME@127.0.0.1:55432/parkly
# PARKLY_VAPID_PRIVATE_KEY=<worker-only-secret>
# PARKLY_VAPID_SUBJECT=mailto:<real-monitored-contact>
# The local launcher generates private keys/credentials automatically in .local/.env.
# This private file also stores PARKLY_FIXTURE_ACCOUNTS (invented accounts only).
